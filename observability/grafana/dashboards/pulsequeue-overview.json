          "legendFormat": "completed"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failure ratio",
      "description": "Failed attempts / finished attempts (failed + succeeded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pulsequeue_jobs_failed_total{tenant=~\"$tenant\", queue=~\"$queue\"}[$__rate_interval])) / clamp_min(sum(rate(pulsequeue_jobs_failed_total{tenant=~\"$tenant\", queue=~\"$queue\"}[$__rate_interval])) + sum(rate(pulsequeue_jobs_completed_total{tenant=~\"$tenant\", queue=~\"$queue\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "failure ratio"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Scheduler leaders",
