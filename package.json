{
  "name": "pulsequeue",
  "version": "0.1.0",
  "description": "Production-style distributed job queue for Node.js — TypeScript, Fastify, PostgreSQL, Redis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "scheduler": "node dist/scheduler.js",
    "scheduler:dev": "tsx watch src/scheduler.ts",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "tsx src/db/migrate-cli.ts",
    "api-key": "node dist/cli/api-key.js",
    "api-key:dev": "tsx src/cli/api-key.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "cron-parser": "^5.10.2",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
