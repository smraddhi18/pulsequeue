# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (source of truth for queues, jobs and attempts)
DATABASE_URL=postgres://pulsequeue:pulsequeue@localhost:5432/pulsequeue
# Connections per process; replicas x PG_POOL_MAX must stay below Postgres max_connections.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
# How long a request waits for a pooled connection before failing with 503.
PG_CONNECTION_TIMEOUT_MS=5000
# Server-side statement_timeout for API queries (migrations disable it).
PG_STATEMENT_TIMEOUT_MS=10000

# Jobs
# Max size of a job payload, in UTF-8 bytes of its JSON (default 256 KiB).
JOB_MAX_PAYLOAD_BYTES=262144

# Worker process (`npm run worker`) — Milestone 2
# Unique per process; defaults to <hostname>-<pid>-<random>. Shows up in logs and jobs.locked_by.
# WORKER_ID=worker-1
# Comma-separated queues to consume; defaults to every queue with a registered handler (echo, demo).
# WORKER_QUEUES=echo,demo
# Max jobs one worker process runs at once. Size PG_POOL_MAX for it (heartbeats + outcomes share the pool).
WORKER_CONCURRENCY=10
# Idle poll interval (jittered +-20%). A full lease batch re-polls immediately.
WORKER_POLL_INTERVAL_MS=1000
# Visibility timeout: a crashed worker's jobs become runnable again this long after its last heartbeat.
WORKER_LEASE_DURATION_MS=30000
# Lease renewal period; must be <= WORKER_LEASE_DURATION_MS / 2.
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Hard cap per attempt; a timed-out attempt is recorded as timed_out and retried.
WORKER_JOB_TIMEOUT_MS=300000
# How often each worker reclaims expired leases (safe to run in every worker).
WORKER_REAPER_INTERVAL_MS=15000
# Poison-message threshold: dead-letter a job after this many lease expiries
# (it keeps crashing or hanging its worker), even with attempts left.
WORKER_POISON_LEASE_EXPIRIES=3
# Drain budget on SIGTERM; unfinished jobs then have their leases released.
# Keep it below the orchestrator's grace period (docker stop_grace_period / k8s terminationGracePeriodSeconds).
WORKER_SHUTDOWN_TIMEOUT_MS=25000
# Optional liveness file the worker loop touches; the compose healthcheck reads its mtime.
# WORKER_LIVENESS_FILE=/tmp/pulsequeue-worker.alive

# Scheduler process (`npm run scheduler`) — Milestone 4
# Run 2 replicas: a Postgres advisory lock elects one leader; only it fires schedules.
# Unique per process; defaults to <hostname>-<pid>-<random>.
# SCHEDULER_ID=scheduler-1
# Leader loop period (jittered +-10%). A full batch re-ticks immediately.
SCHEDULER_TICK_INTERVAL_MS=1000
# How often a standby retries the leader lock (jittered +-20%) = worst-case failover delay.
SCHEDULER_LEADER_RETRY_INTERVAL_MS=5000
# Max due schedules claimed per transaction.
SCHEDULER_BATCH_SIZE=100
# An occurrence later than this is a misfire and handled by the schedule's misfire policy
# (skip | fire_once | catch_up). Must be >= 2x SCHEDULER_TICK_INTERVAL_MS.
SCHEDULER_MISFIRE_GRACE_MS=60000
# catch_up policy: at most this many missed occurrences are replayed per schedule.
SCHEDULER_MAX_CATCH_UP=10
# Budget for finishing the in-flight tick on SIGTERM before leadership is released.
SCHEDULER_SHUTDOWN_TIMEOUT_MS=10000
# Optional liveness file the scheduler loop touches (leader and standby).
# SCHEDULER_LIVENESS_FILE=/tmp/pulsequeue-scheduler.alive

# Retries: delay before retry n = random(0, min(MAX, BASE * 2^(n-1)))  ("full jitter")
RETRY_BACKOFF_BASE_MS=1000
RETRY_BACKOFF_MAX_MS=300000

# Readiness probe budget per dependency check
READINESS_TIMEOUT_MS=2000

# Redis — Milestone 5. An accelerator, never the source of truth: comment out
# REDIS_URL and every Redis feature turns off (workers poll, stats hit Postgres).
# A Redis outage at runtime degrades the same way: /ready reports "degraded"
# (HTTP 200), workers fall back to WORKER_POLL_INTERVAL_MS, stats are computed
# directly (x-cache: BYPASS). No job is ever lost or delayed past the poll interval.
REDIS_URL=redis://localhost:6379
# Namespace for every key and channel (e.g. pq-staging), so environments can share one Redis.
REDIS_KEY_PREFIX=pq
# TCP connect + handshake budget per attempt.
REDIS_CONNECT_TIMEOUT_MS=2000
# Per-command budget; a slow Redis must never slow a request down (it falls back instead).
REDIS_COMMAND_TIMEOUT_MS=500
# Reconnect backoff: random(cap/2, cap), cap = min(MAX, BASE * 2^(attempt-1)).
REDIS_RECONNECT_BASE_MS=100
REDIS_RECONNECT_MAX_MS=5000

# Wake-ups: enqueue/replay/retry/scheduler publish "queue X has work" (after COMMIT)
# on <prefix>:wakeup:<queue>; idle workers block on it instead of polling.
WAKEUP_ENABLED=true
# Per-queue publish coalescing: at most ~2 publishes per queue per window.
WAKEUP_COALESCE_MS=50
# Worker idle poll while subscribed (jittered +-20%): only a safety net for lost
# messages. Delayed jobs/retries get their own timer from the next due run_at.
# Must be >= WORKER_POLL_INTERVAL_MS.
WORKER_WAKEUP_FALLBACK_POLL_MS=30000

# Stats cache for GET /queues/:name/stats (response header x-cache: HIT|STALE|MISS|BYPASS).
STATS_CACHE_ENABLED=true
# Hard expiry = worst-case staleness if every invalidation for a queue were lost.
STATS_CACHE_TTL_MS=10000
# A dirty entry younger than this is still served (x-cache: STALE): caps recomputes
# at ~1 per queue per interval across all API instances. Must be < STATS_CACHE_TTL_MS.
STATS_CACHE_MIN_REFRESH_MS=1000
# Per-queue coalescing of invalidation (dirty-flag) writes.
STATS_INVALIDATION_COALESCE_MS=100

# Authentication — Milestone 6. Every route except /health and /ready needs
# `Authorization: Bearer pq_<prefix>_<secret>`; there is no switch to turn it off.
# Bootstrap the first admin key with the CLI (the token is printed once):
#   npm run api-key -- create --tenant acme --role admin --name bootstrap --create-tenant
# How long an API instance trusts a verified key before re-checking Postgres.
# Bounds how long a revoked key still works on OTHER instances. 0 = check every request.
AUTH_CACHE_TTL_MS=5000
# Max verified keys cached per instance (LRU).
AUTH_CACHE_MAX_ENTRIES=10000

# Enqueue rate limiting — Milestone 6. Token buckets in Redis (atomic Lua, Redis
# clock), per tenant and optionally per queue (PUT /queues/:name/settings).
# Without REDIS_URL there is nowhere to keep shared buckets, so limiting is off.
RATE_LIMIT_ENABLED=true
# Default per-tenant budget (override per tenant: npm run api-key -- tenant-rate-limit ...).
RATE_LIMIT_TENANT_PER_SEC=100
RATE_LIMIT_TENANT_BURST=200
# Redis unreachable: open = enqueue unlimited (logs ratelimit.unavailable),
# closed = 503 + Retry-After (hard quotas; requires REDIS_URL).
RATE_LIMIT_FAIL_MODE=open
# How long an instance caches a queue's own limit; PUT settings applies at once on
# the instance that served it and within this TTL on the others. 0 = no cache.
RATE_LIMIT_SETTINGS_CACHE_TTL_MS=5000

# Integration tests (npm test) run against this database when set; each suite
# creates and drops its own schema, so a dev database is safe to use.
# TEST_DATABASE_URL=postgres://pulsequeue:pulsequeue@localhost:5432/pulsequeue_test
# Redis integration tests run when this is set too; each test uses its own key prefix.
# TEST_REDIS_URL=redis://localhost:6379
